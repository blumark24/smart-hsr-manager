{
  "name": "smart-hsr-mobile-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "doctor": "npx cap doctor",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "sync": "npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "native:permissions": "node scripts/configure-native-permissions.mjs",
    "bundle:web": "node scripts/build-web-bundle.mjs",
    "build:android:rc": "npm run bundle:web && npx cap sync android",
    "build:ios:rc": "npm run bundle:web && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.1.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.1",
    "@capacitor/network": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "typescript": "^5.9.0"
  }
}
