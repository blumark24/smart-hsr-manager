rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // Helpers
    // ==========================================================
    function signedIn() {
      return request.auth != null;
    }

    // --- Owner ---
    // active-owner check is used ONLY by organizations/ and invoices/
    // below. It grants no access to users/ or observations/ — that
    // owner bypass was removed intentionally (verified deployed
    // behavior: owner has no access to those two collections).
    function ownerRecord() {
      return get(/databases/$(database)/documents/owners/$(request.auth.uid));
    }
    function isActiveOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && ownerRecord().data.active != false;
    }

    // --- Manager ---
    function managerRecord() {
      return get(/databases/$(database)/documents/managers/$(request.auth.uid));
    }
    function isActiveManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/managers/$(request.auth.uid))
        && managerRecord().data.role == 'manager'
        && managerRecord().data.active != false
        && managerRecord().data.organizationId is string
        && managerRecord().data.organizationId.size() > 0;
    }
    function managerOrgId() {
      return isActiveManager() ? managerRecord().data.organizationId : null;
    }

    // --- Supervisor / inspector / contractor (users/{uid}) ---
    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActiveOrgUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRecord().data.role in ['supervisor', 'inspector', 'contractor']
        && userRecord().data.active != false
        && userRecord().data.organizationId is string
        && userRecord().data.organizationId.size() > 0;
    }
    function orgUserOrgId() {
      return isActiveOrgUser() ? userRecord().data.organizationId : null;
    }
    function orgUserRole() {
      return isActiveOrgUser() ? userRecord().data.role : null;
    }

    // --- Smart Mobility roles (users/{uid}) ---
    // municipality_manager reuses the existing manager account above; these
    // four are new role values in the same users/{uid} collection.
    function isActiveMobilityUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRecord().data.role in ['mobility_head', 'department_head', 'administrative_affairs', 'employee']
        && userRecord().data.active != false
        && userRecord().data.organizationId is string
        && userRecord().data.organizationId.size() > 0;
    }
    function mobilityUserOrgId() {
      return isActiveMobilityUser() ? userRecord().data.organizationId : null;
    }
    function mobilityUserRole() {
      return isActiveMobilityUser() ? userRecord().data.role : null;
    }
    function mobilityUserDept() {
      return isActiveMobilityUser() ? userRecord().data.department : null;
    }

    // An auditEvents write's actorId/actorRole/organizationId alone say
    // nothing about whether the resourceId it names is real, in the
    // actor's own organization, or something the actor actually has a
    // relationship to — a same-org employee could otherwise write a
    // perfectly self-consistent event that semantically forges someone
    // else's mission, a cross-org resource, or a nonexistent id. This
    // closes that gap with one bounded get()/exists() pair (short-circuited
    // by resourceType, so exactly one branch below ever touches Firestore)
    // per create, checked against each resource's own recorded
    // organizationId and, for an employee actor, its own ownership field —
    // the same fields each resource's own rules below already trust.
    function auditReferencedResourceOk(role, uid, resourceType, resourceId, organizationId) {
      return
        (resourceType == 'mission'
          && exists(/databases/$(database)/documents/missions/$(resourceId))
          && get(/databases/$(database)/documents/missions/$(resourceId)).data.organizationId == organizationId
          && (role != 'employee' || get(/databases/$(database)/documents/missions/$(resourceId)).data.assignedEmployeeUid == uid))
        || (resourceType == 'vehicle'
          && exists(/databases/$(database)/documents/vehicles/$(resourceId))
          && get(/databases/$(database)/documents/vehicles/$(resourceId)).data.organizationId == organizationId
          && (role != 'employee' || get(/databases/$(database)/documents/vehicles/$(resourceId)).data.assignedEmployeeUid == uid))
        || (resourceType == 'incident'
          && exists(/databases/$(database)/documents/incidents/$(resourceId))
          && get(/databases/$(database)/documents/incidents/$(resourceId)).data.organizationId == organizationId
          && (role != 'employee' || get(/databases/$(database)/documents/incidents/$(resourceId)).data.createdByUid == uid));
    }

    // ==========================================================
    // managers/{managerId} — signed-in self-read only, no client writes
    // ==========================================================
    match /managers/{managerId} {
      allow read: if request.auth.uid == managerId;
      allow write: if false;
    }

    // ==========================================================
    // owners/{ownerId} — signed-in self-read only, no client writes
    // ==========================================================
    match /owners/{ownerId} {
      allow read: if request.auth.uid == ownerId;
      allow write: if false;
    }

    // ==========================================================
    // users/{userId} — tenant isolation, NO owner access
    // ==========================================================
    match /users/{userId} {
      allow read: if request.auth.uid == userId
        || (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (orgUserRole() == 'supervisor' && resource.data.organizationId == orgUserOrgId())
        // mobility_head must list org employees to allocate a vehicle to
        // one — scoped strictly to employee-role records, not every user.
        || (mobilityUserRole() == 'mobility_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.role == 'employee');
      allow write: if false;
    }

    // ==========================================================
    // employees/{employeeId} — Phase 03B Unified User Center. Municipal
    // employee MASTER REGISTRY records, separate from users/{uid} login
    // accounts (an employee can exist here with no Auth account at all —
    // see api/admin/employees.js). Same tenant-isolation shape as users/:
    // manager reads their whole organization, a department_head reads only
    // their own department within it. All writes go through the Admin API
    // only (real Auth account creation, audit trail) — never a direct
    // client write.
    // ==========================================================
    match /employees/{employeeId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() == 'department_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.department == mobilityUserDept());
      allow write: if false;
    }

    // ==========================================================
    // observations/{obsId} — tenant isolation, NO owner access
    // ==========================================================
    match /observations/{obsId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (isActiveOrgUser() && resource.data.organizationId == orgUserOrgId());

      allow create: if orgUserRole() == 'inspector'
        && validInspectorObservationCreate(obsId);

      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && (canManagerUpdateObservation() || canSupervisorUpdateObservation()
            || canInspectorUpdateObservation() || canContractorUpdateObservation());

      // manager-only, same-org (manager.html:1775 deleteObservation)
      allow delete: if isActiveManager() && resource.data.organizationId == managerOrgId();
    }

    function validInspectorObservationCreate(obsId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'clientRequestId', 'organizationId', 'createdByUid', 'status',
          'displayId', 'type', 'date', 'title', 'details', 'imagePath',
          'imageObjectKey', 'isComparative', 'actionPlan', 'riskAssessment',
          'location', 'originalLat', 'originalLng', 'correctedLat',
          'correctedLng', 'locationAccuracyMeters', 'locationCapturedAt',
          'locationSource', 'locationVerified', 'createdAt'
        ])
        && data.clientRequestId == obsId
        && data.clientRequestId is string
        && data.organizationId == orgUserOrgId()
        && data.createdByUid == request.auth.uid
        && data.status == 'PENDING'
        && data.displayId is int
        && data.type is string
        && data.date is string
        && data.title is string
        && data.details is string
        && data.imagePath is string
        && (!data.keys().hasAny(['imageObjectKey'])
            || data.imageObjectKey == null
            || data.imageObjectKey is string)
        && data.isComparative == false
        && data.actionPlan is string
        && data.riskAssessment is map
        && data.riskAssessment.keys().hasOnly(['priority', 'timeframe'])
        && data.location is string
        && data.locationSource is string
        && data.locationVerified is bool
        && data.createdAt == request.time;
    }

    // manager: cycleStatus / closeTicket / confirmAssign (manager.html:981,991,1037)
    function canManagerUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isActiveManager()
        && resource.data.organizationId == managerOrgId()
        && resource.data.status != 'COMPLETED'
        && changedKeys.hasOnly(
             ['status', 'closedAt', 'updatedByUid', 'updatedAt',
              'assignedContractorUid', 'assignedByUid', 'assignedAt', 'supervisorNote'])
        && (!changedKeys.hasAny(['updatedByUid']) || request.resource.data.updatedByUid == request.auth.uid)
        && (!changedKeys.hasAny(['status']) || isManagerTransition());
    }

    function isManagerTransition() {
      return (resource.data.status == 'PENDING' && request.resource.data.status == 'IN_PROGRESS')
        || (resource.data.status == 'PENDING_REVIEW' && request.resource.data.status == 'IN_PROGRESS')
        || (resource.data.status == 'PENDING_REVIEW' && request.resource.data.status == 'COMPLETED');
    }

    // supervisor: confirmAssign / review-return (manager.html:1037) — a
    // separate least-privilege branch, never merged into the manager branch.
    // Assignment fields + supervisorNote are allowed; COMPLETED and delete
    // remain manager-exclusive.
    function canSupervisorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'supervisor'
        && resource.data.organizationId == orgUserOrgId()
        && resource.data.status != 'COMPLETED'
        && request.resource.data.createdByUid == resource.data.createdByUid
        && changedKeys.hasOnly(
             ['status', 'supervisorNote', 'assignedContractorUid',
              'assignedByUid', 'assignedAt', 'updatedByUid', 'updatedAt'])
        && request.resource.data.updatedByUid == request.auth.uid
        && (
          !changedKeys.hasAny(['status'])
          || (resource.data.status == 'PENDING' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'PENDING_REVIEW' && request.resource.data.status == 'IN_PROGRESS')
        );
    }

    // inspector: completeObservation (dashboard.html:4373)
    function canInspectorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'inspector'
        && resource.data.organizationId == orgUserOrgId()
        && resource.data.status != 'COMPLETED'
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && !resource.data.keys().hasAny(['assignedContractorUid'])
        && request.resource.data.status == resource.data.status
        && changedKeys.hasOnly(['isComparative', 'afterImagePath', 'resolutionNote']);
    }

    // contractor: status/resolution flow (mobile-map.html:1460, :1470/:1171)
    function canContractorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'contractor'
        && resource.data.organizationId == orgUserOrgId()
        && resource.data.status != 'COMPLETED'
        && resource.data.assignedContractorUid == request.auth.uid
        && request.resource.data.assignedContractorUid == resource.data.assignedContractorUid
        && changedKeys.hasOnly(['status', 'resolutionNote', 'afterImagePath', 'updatedByUid', 'updatedAt'])
        && request.resource.data.updatedByUid == request.auth.uid
        && (!changedKeys.hasAny(['status']) || isContractorTransition());
    }

    function isContractorTransition() {
      return (resource.data.status == 'PENDING' && request.resource.data.status == 'IN_PROGRESS')
        || (resource.data.status == 'IN_PROGRESS' && request.resource.data.status == 'PENDING_REVIEW');
    }

    // ==========================================================
    // missions/{missionId} — Smart Mobility shared mission lifecycle.
    // Tenant isolation, department scoping for department_head, and
    // assignment scoping for employee. Mirrors
    // platform/policies/mission-workflow-policy.js — keep both in sync.
    // ==========================================================
    match /missions/{missionId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() == 'mobility_head' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'administrative_affairs' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'department_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.department == mobilityUserDept())
        || (mobilityUserRole() == 'employee' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.assignedEmployeeUid == request.auth.uid);

      // Only a department head may create a mission request, as a DRAFT, in
      // their own organization and department, self-attributed.
      allow create: if mobilityUserRole() == 'department_head'
        && request.resource.data.organizationId == mobilityUserOrgId()
        && request.resource.data.department == mobilityUserDept()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'DRAFT';

      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && (canDeptHeadSubmitMission() || canAdminAffairsDecideMission()
            || canMobilityHeadAdvanceMission() || canEmployeeAdvanceMission());

      // Missions are append/close only — never deleted.
      allow delete: if false;
    }

    // department_head: DRAFT -> PENDING_APPROVAL, own mission only.
    function canDeptHeadSubmitMission() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'department_head'
        && resource.data.organizationId == mobilityUserOrgId()
        && resource.data.department == mobilityUserDept()
        && resource.data.createdByUid == request.auth.uid
        && resource.data.status == 'DRAFT' && request.resource.data.status == 'PENDING_APPROVAL'
        && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // administrative_affairs: PENDING_APPROVAL -> APPROVED | REJECTED | DRAFT.
    function canAdminAffairsDecideMission() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'administrative_affairs'
        && resource.data.organizationId == mobilityUserOrgId()
        && resource.data.status == 'PENDING_APPROVAL'
        && (request.resource.data.status == 'APPROVED'
            || request.resource.data.status == 'REJECTED'
            || request.resource.data.status == 'DRAFT')
        && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // mobility_head: allocate vehicle, handover, resume after incident,
    // confirm return.
    function canMobilityHeadAdvanceMission() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'mobility_head'
        && resource.data.organizationId == mobilityUserOrgId()
        && (
          (resource.data.status == 'APPROVED' && request.resource.data.status == 'VEHICLE_ALLOCATED'
            && changedKeys.hasOnly(['status', 'vehicleId', 'assignedEmployeeUid', 'assignedEmployeeName', 'updatedAt', 'updatedByUid'])
            && request.resource.data.vehicleId is string && request.resource.data.vehicleId.size() > 0
            && request.resource.data.assignedEmployeeUid is string && request.resource.data.assignedEmployeeUid.size() > 0
            // Conflict-prevention cross-check: refuse to allocate a vehicle
            // that is not currently AVAILABLE. Real atomicity against a
            // second, racing allocation still requires the caller to write
            // this and the vehicle doc inside one runTransaction() — see
            // platform/policies/vehicle-workflow-policy.js.
            && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.organizationId == mobilityUserOrgId()
            && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.status == 'AVAILABLE')
          || (resource.data.status == 'VEHICLE_ALLOCATED' && request.resource.data.status == 'HANDED_OVER'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
          || (resource.data.status == 'INCIDENT_HOLD' && request.resource.data.status == 'IN_PROGRESS'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
          || (resource.data.status == 'AWAITING_RETURN' && request.resource.data.status == 'CLOSED'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
        )
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // employee: receive, start, report/resolve incident, finish, return
    // vehicle — only on a mission assigned to them.
    function canEmployeeAdvanceMission() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'employee'
        && resource.data.organizationId == mobilityUserOrgId()
        && resource.data.assignedEmployeeUid == request.auth.uid
        && (
          (resource.data.status == 'HANDED_OVER' && request.resource.data.status == 'READY')
          || (resource.data.status == 'READY' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'IN_PROGRESS' && (request.resource.data.status == 'INCIDENT_HOLD'
              || request.resource.data.status == 'COMPLETED'))
          || (resource.data.status == 'INCIDENT_HOLD' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'COMPLETED' && request.resource.data.status == 'AWAITING_RETURN')
        )
        && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // ==========================================================
    // vehicles/{vehicleId} — Smart Mobility fleet lifecycle. Tenant
    // isolation; only mobility_head manages the roster and its state;
    // the assigned employee may only report a return. Mirrors
    // platform/policies/vehicle-workflow-policy.js — keep both in sync.
    // ==========================================================
    match /vehicles/{vehicleId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() == 'mobility_head' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'administrative_affairs' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'employee' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.assignedEmployeeUid == request.auth.uid);

      // Only mobility_head adds vehicles to the roster, always starting
      // AVAILABLE with no stale mission commitment.
      allow create: if mobilityUserRole() == 'mobility_head'
        && request.resource.data.organizationId == mobilityUserOrgId()
        && request.resource.data.status == 'AVAILABLE'
        && !('assignedEmployeeUid' in request.resource.data)
        && !('currentMissionId' in request.resource.data);

      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && (canMobilityHeadManageVehicle() || canEmployeeReturnVehicle());

      // Vehicles are never deleted — retired vehicles move to
      // OUT_OF_SERVICE so their history stays auditable.
      allow delete: if false;
    }

    // mobility_head: allocate (with conflict-prevention cross-check
    // against the target mission), maintenance toggles, handover,
    // confirm return.
    function canMobilityHeadManageVehicle() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'mobility_head'
        && resource.data.organizationId == mobilityUserOrgId()
        && (
          (resource.data.status == 'AVAILABLE' && request.resource.data.status == 'RESERVED'
            && changedKeys.hasOnly(['status', 'assignedEmployeeUid', 'currentMissionId', 'updatedAt', 'updatedByUid'])
            && request.resource.data.assignedEmployeeUid is string && request.resource.data.assignedEmployeeUid.size() > 0
            && request.resource.data.currentMissionId is string && request.resource.data.currentMissionId.size() > 0
            // Conflict-prevention cross-check: the mission being allocated
            // must actually be APPROVED and in this same organization.
            && get(/databases/$(database)/documents/missions/$(request.resource.data.currentMissionId)).data.organizationId == mobilityUserOrgId()
            && get(/databases/$(database)/documents/missions/$(request.resource.data.currentMissionId)).data.status == 'APPROVED'
            // Phase 03B: vehicleEligible is an independent, real,
            // server-enforced entitlement (a UI checkbox alone is not
            // sufficient authorization) — an EXPLICIT false on the target
            // employee's own record blocks a NEW allocation to them.
            // Backward-compatible: a record with no vehicleEligible field
            // at all (every employee created before this field existed)
            // stays allocatable, exactly as before.
            && (!('vehicleEligible' in get(/databases/$(database)/documents/users/$(request.resource.data.assignedEmployeeUid)).data)
              || get(/databases/$(database)/documents/users/$(request.resource.data.assignedEmployeeUid)).data.vehicleEligible != false))
          || (resource.data.status == 'AVAILABLE'
            && (request.resource.data.status == 'MAINTENANCE' || request.resource.data.status == 'OUT_OF_SERVICE')
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
          || (resource.data.status == 'RESERVED' && request.resource.data.status == 'IN_MISSION'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
          || (resource.data.status == 'RETURN_PENDING' && request.resource.data.status == 'AVAILABLE'
            && changedKeys.hasOnly(['status', 'assignedEmployeeUid', 'currentMissionId', 'updatedAt', 'updatedByUid'])
            && !('assignedEmployeeUid' in request.resource.data) && !('currentMissionId' in request.resource.data))
          || ((resource.data.status == 'MAINTENANCE' || resource.data.status == 'OUT_OF_SERVICE')
            && request.resource.data.status == 'AVAILABLE'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
        )
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // employee: report a return, only on the vehicle assigned to them.
    function canEmployeeReturnVehicle() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'employee'
        && resource.data.organizationId == mobilityUserOrgId()
        && resource.data.assignedEmployeeUid == request.auth.uid
        && resource.data.status == 'IN_MISSION' && request.resource.data.status == 'RETURN_PENDING'
        && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // ==========================================================
    // presence/{presenceId} — verified deployed behavior, manager-only
    // ==========================================================
    match /presence/{presenceId} {
      allow read: if isActiveManager();
      allow write: if isActiveManager()
        && presenceId == request.auth.token.email;
    }

    // ==========================================================
    // organizations/{orgId} — active owner only
    // ==========================================================
    match /organizations/{orgId} {
      allow read, write: if isActiveOwner();
    }

    // ==========================================================
    // invoices/{invoiceId} — active owner only (read + create; no
    // update/delete call site exists in the app)
    // ==========================================================
    match /invoices/{invoiceId} {
      allow read: if isActiveOwner();
      allow create: if isActiveOwner();
      allow update, delete: if false;
    }

    // ==========================================================
    // incidents/{incidentId} — Smart Mobility incident lifecycle. Created
    // only by the employee assigned to the referenced mission while it is
    // IN_PROGRESS; processed only by mobility_head. Mirrors
    // platform/policies/incident-workflow-policy.js — keep both in sync.
    // ==========================================================
    match /incidents/{incidentId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() == 'mobility_head' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'administrative_affairs' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'department_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.department == mobilityUserDept())
        || (mobilityUserRole() == 'employee' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.createdByUid == request.auth.uid);

      // Only the employee assigned to the referenced (currently
      // IN_PROGRESS) mission may open an incident against it.
      allow create: if mobilityUserRole() == 'employee'
        && request.resource.data.organizationId == mobilityUserOrgId()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'NEW'
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.organizationId == mobilityUserOrgId()
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.assignedEmployeeUid == request.auth.uid
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.status == 'IN_PROGRESS';

      // mobility_head processes: NEW -> ACKNOWLEDGED -> IN_PROGRESS -> RESOLVED.
      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && mobilityUserRole() == 'mobility_head'
        && resource.data.organizationId == mobilityUserOrgId()
        && (
          (resource.data.status == 'NEW' && request.resource.data.status == 'ACKNOWLEDGED')
          || (resource.data.status == 'ACKNOWLEDGED' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'IN_PROGRESS' && request.resource.data.status == 'RESOLVED')
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;

      // Incidents are never deleted — they are the record of what happened.
      allow delete: if false;
    }

    // ==========================================================
    // auditEvents/{eventId} — append-only Smart Mobility audit trail.
    // Every mission/vehicle/incident transition writes one of these.
    // Mirrors platform/audit/mobility-audit-event-contract.js.
    // ==========================================================
    match /auditEvents/{eventId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() in ['mobility_head', 'administrative_affairs'] && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'department_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.department == mobilityUserDept())
        || (mobilityUserRole() == 'employee' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.actorId == request.auth.uid);

      // An actor may only ever record an event as themselves, in their own
      // organization — never on another user's behalf, never cross-tenant —
      // and the resource it names must be real, in that same organization,
      // and (for an employee) actually theirs. See auditReferencedResourceOk.
      allow create: if isActiveMobilityUser()
        && request.resource.data.organizationId == mobilityUserOrgId()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == mobilityUserRole()
        && request.resource.data.resourceType in ['mission', 'vehicle', 'incident']
        && auditReferencedResourceOk(mobilityUserRole(), request.auth.uid,
             request.resource.data.resourceType, request.resource.data.resourceId,
             request.resource.data.organizationId);

      // Audit records are immutable once written.
      allow update, delete: if false;
    }

    // ==========================================================
    // adminAuditEvents/{eventId} — append-only User Center audit trail
    // (account creation, enable/disable, role/service-entitlement change,
    // password reset). Written ONLY by api/admin/users.js via the Firebase
    // Admin SDK, which bypasses these rules entirely and derives
    // actorId/actorRole/organizationId itself from the verified caller's
    // own token (getCallerContext) — never from client-supplied fields —
    // so a client can never forge, write, or spoof one of these records.
    // No password/token/credential is ever stored in these documents.
    // ==========================================================
    match /adminAuditEvents/{eventId} {
      allow read: if isActiveOwner()
        || (isActiveManager() && resource.data.organizationId == managerOrgId());
      allow write: if false;
    }

    // ==========================================================
    // SMART LANDS — reconciled verbatim from the authoritative source
    // (blumark24/smart-hsr-lands, branch staging/lands-trusted-audit,
    // firebase/firestore.rules, targeting the same shared
    // smart-hsr-staging-blumark24 project via that repo's own .firebaserc).
    // Included unmodified except for signedIn(), which is identical to
    // this file's own signedIn() above and is not redefined here (Firestore
    // rejects a duplicate function name in one service block). No other
    // helper name here collides with a Platform Core/Field Survey/Smart
    // Mobility helper above — verified by diffing every `function` name in
    // both source files before merging. Every collection below is scoped
    // under landsMunicipalities/{municipalityId}/..., isolating Lands
    // tenancy by municipality independently of this file's own
    // organizationId-based isolation for Core/Field Survey/Mobility —
    // deliberately left as two coexisting, independently-correct tenancy
    // mechanisms rather than force-unified in this phase.
    // ==========================================================
    function accessPath(municipalityId, uid) { return /databases/$(database)/documents/landsMunicipalities/$(municipalityId)/userAccess/$(uid); }
    function membership(municipalityId) { return get(accessPath(municipalityId, request.auth.uid)).data; }
    function enabledMember(municipalityId) { return signedIn() && exists(accessPath(municipalityId, request.auth.uid)) && membership(municipalityId).enabled == true && membership(municipalityId).municipality_id == municipalityId && membership(municipalityId).firebase_uid == request.auth.uid; }
    function hasRole(municipalityId, role) { return enabledMember(municipalityId) && membership(municipalityId).lands_role == role; }
    function manager(municipalityId) { return hasRole(municipalityId, 'municipal_manager') || hasRole(municipalityId, 'lands_department_manager'); }
    function regularDomain(domain) { return domain in ['royalOrders', 'allocationDecisions', 'beneficiaries', 'plans', 'parcels']; }
    function safeId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function documentRecordDomain(domain) { return domain in ['landGrants', 'royalOrders', 'allocationDecisions', 'beneficiaries', 'plans', 'parcels']; }
    function recordPath(municipalityId, domain, recordId) { return /databases/$(database)/documents/landsMunicipalities/$(municipalityId)/$(domain)/$(recordId); }
    function recordExists(municipalityId, domain, recordId) { return documentRecordDomain(domain) && safeId(recordId) && exists(recordPath(municipalityId, domain, recordId)) && get(recordPath(municipalityId, domain, recordId)).data.municipality_id == municipalityId; }
    function canAttachDocument(municipalityId, domain, recordId) { return recordExists(municipalityId, domain, recordId) && (manager(municipalityId) || get(recordPath(municipalityId, domain, recordId)).data.created_by == request.auth.uid); }
    function expectedStoragePath(municipalityId, domain, recordId, fileId) { return 'landsMunicipalities/' + municipalityId + '/documents/' + domain + '/' + recordId + '/' + fileId; }
    function hasNoDerivedState() { return !('completeness' in request.resource.data) && !('completenessPercentage' in request.resource.data) && !('completionPercentage' in request.resource.data) && !('isComplete' in request.resource.data) && !('percentage' in request.resource.data) && !('missingRequirements' in request.resource.data) && !('missingFields' in request.resource.data) && !('completedRequirements' in request.resource.data) && !('computedStatus' in request.resource.data); }
    function tenantDocument(municipalityId) { return request.resource.data.municipality_id == municipalityId && hasNoDerivedState(); }
    function validLandGrant(municipalityId) {
      return tenantDocument(municipalityId) && request.resource.data.keys().hasOnly(['municipality_id', 'beneficiary', 'royal_order', 'allocation_decision', 'beneficiary_id', 'royal_order_id', 'allocation_decision_id', 'plan_id', 'parcel_id', 'document_ids', 'status', 'created_by', 'created_at', 'updated_at']) && request.resource.data.created_by is string && request.resource.data.status in ['draft', 'under_review', 'incomplete', 'approved', 'rejected'];
    }
    function validDomainDocument(municipalityId) {
      return tenantDocument(municipalityId) && request.resource.data.keys().hasOnly(['municipality_id', 'created_by', 'created_at', 'updated_at', 'reference_id', 'name', 'description', 'land_grant_id', 'royal_order_id', 'allocation_decision_id', 'beneficiary_id', 'plan_id', 'parcel_id', 'document_ids']) && request.resource.data.created_by is string;
    }
    function validDocumentMetadata(municipalityId, documentId) {
      return tenantDocument(municipalityId) && request.resource.data.keys().hasOnly(['municipality_id', 'created_by', 'created_at', 'updated_at', 'record_domain', 'record_id', 'file_id', 'filename', 'mime_type', 'storage_path', 'size_bytes']) &&
        request.resource.data.created_by is string && documentRecordDomain(request.resource.data.record_domain) && safeId(request.resource.data.record_id) &&
        safeId(request.resource.data.file_id) && request.resource.data.file_id == documentId && request.resource.data.filename is string &&
        request.resource.data.filename.matches('^[A-Za-z0-9][A-Za-z0-9._ -]{0,127}$') && request.resource.data.mime_type in ['application/pdf', 'image/jpeg', 'image/png'] &&
        request.resource.data.size_bytes is int && request.resource.data.size_bytes > 0 && request.resource.data.size_bytes <= 10 * 1024 * 1024 &&
        request.resource.data.storage_path == expectedStoragePath(municipalityId, request.resource.data.record_domain, request.resource.data.record_id, request.resource.data.file_id) &&
        canAttachDocument(municipalityId, request.resource.data.record_domain, request.resource.data.record_id);
    }
    match /landsMunicipalities/{municipalityId}/userAccess/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || hasRole(municipalityId, 'municipal_manager'));
      allow list: if hasRole(municipalityId, 'municipal_manager');
      // Entitlement grant/enable/disable/role-change is a consequential,
      // trusted-audited operation. The trusted server runtime writes this
      // through Admin access (which Rules do not gate); the browser Client
      // SDK may never write it directly.
      allow create, update, delete: if false;
    }
    match /landsMunicipalities/{municipalityId}/landGrants/{grantId} {
      allow read: if enabledMember(municipalityId);
      allow create: if enabledMember(municipalityId) && validLandGrant(municipalityId) && request.resource.data.created_by == request.auth.uid && request.resource.data.status == 'draft';
      // A draft's own author may still edit its (pre-workflow) content
      // directly. Any status transition (transition/approve/reject) is a
      // consequential, trusted-audited operation and is server-only.
      allow update: if validLandGrant(municipalityId) && resource.data.municipality_id == municipalityId && request.resource.data.created_by == resource.data.created_by && request.resource.data.municipality_id == resource.data.municipality_id && resource.data.created_by == request.auth.uid && resource.data.status == 'draft' && request.resource.data.status == 'draft' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['beneficiary', 'royal_order', 'allocation_decision', 'beneficiary_id', 'royal_order_id', 'allocation_decision_id', 'plan_id', 'parcel_id', 'document_ids', 'updated_at']);
      // land_grant.delete is a consequential, trusted-audited operation.
      allow delete: if false;
    }
    match /landsMunicipalities/{municipalityId}/documents/{documentId} {
      allow read: if enabledMember(municipalityId);
      allow create: if enabledMember(municipalityId) && request.resource.data.created_by == request.auth.uid && validDocumentMetadata(municipalityId, documentId);
      // document.replace and document.delete are consequential, trusted-audited
      // operations and are server-only. Initial upload (create) stays client-side.
      allow update, delete: if false;
    }
    match /landsMunicipalities/{municipalityId}/{domain}/{entityId} {
      allow read: if enabledMember(municipalityId) && regularDomain(domain);
      allow create: if enabledMember(municipalityId) && regularDomain(domain) && validDomainDocument(municipalityId) && request.resource.data.created_by == request.auth.uid;
      // *.update and *.delete for every regular domain are consequential,
      // trusted-audited operations and are server-only.
      allow update, delete: if false;
    }
    match /landsMunicipalities/{municipalityId}/auditLogs/{auditId} {
      allow read: if manager(municipalityId);
      // A client-writable audit trail is forgeable. Trusted server ingestion is a
      // separate production decision and is intentionally not provided here.
      allow create, update, delete: if false;
    }

    // ==========================================================
    // Final fallback — everything else denied.
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
