rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // Helpers
    // ==========================================================
    function signedIn() {
      return request.auth != null;
    }

    // --- Owner ---
    // active-owner check is used ONLY by organizations/ and invoices/
    // below. It grants no access to users/ or observations/ — that
    // owner bypass was removed intentionally (verified deployed
    // behavior: owner has no access to those two collections).
    function ownerRecord() {
      return get(/databases/$(database)/documents/owners/$(request.auth.uid));
    }
    function isActiveOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && ownerRecord().data.active != false;
    }

    // --- Manager ---
    function managerRecord() {
      return get(/databases/$(database)/documents/managers/$(request.auth.uid));
    }
    function isActiveManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/managers/$(request.auth.uid))
        && managerRecord().data.role == 'manager'
        && managerRecord().data.active != false
        && managerRecord().data.organizationId is string
        && managerRecord().data.organizationId.size() > 0;
    }
    function managerOrgId() {
      return isActiveManager() ? managerRecord().data.organizationId : null;
    }

    // --- Supervisor / inspector / contractor (users/{uid}) ---
    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActiveOrgUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRecord().data.role in ['supervisor', 'inspector', 'contractor']
        && userRecord().data.active != false
        && userRecord().data.organizationId is string
        && userRecord().data.organizationId.size() > 0;
    }
    function orgUserOrgId() {
      return isActiveOrgUser() ? userRecord().data.organizationId : null;
    }
    function orgUserRole() {
      return isActiveOrgUser() ? userRecord().data.role : null;
    }

    // --- Smart Mobility roles (users/{uid}) ---
    // municipality_manager reuses the existing manager account above; these
    // four are new role values in the same users/{uid} collection.
    function isActiveMobilityUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRecord().data.role in ['mobility_head', 'department_head', 'administrative_affairs', 'employee']
        && userRecord().data.active != false
        && userRecord().data.organizationId is string
        && userRecord().data.organizationId.size() > 0;
    }
    function mobilityUserOrgId() {
      return isActiveMobilityUser() ? userRecord().data.organizationId : null;
    }
    function mobilityUserRole() {
      return isActiveMobilityUser() ? userRecord().data.role : null;
    }
    function mobilityUserDept() {
      return isActiveMobilityUser() ? userRecord().data.department : null;
    }

    // ==========================================================
    // managers/{managerId} — signed-in self-read only, no client writes
    // ==========================================================
    match /managers/{managerId} {
      allow read: if request.auth.uid == managerId;
      allow write: if false;
    }

    // ==========================================================
    // owners/{ownerId} — signed-in self-read only, no client writes
    // ==========================================================
    match /owners/{ownerId} {
      allow read: if request.auth.uid == ownerId;
      allow write: if false;
    }

    // ==========================================================
    // users/{userId} — tenant isolation, NO owner access
    // ==========================================================
    match /users/{userId} {
      allow read: if request.auth.uid == userId
        || (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (orgUserRole() == 'supervisor' && resource.data.organizationId == orgUserOrgId())
        // mobility_head must list org employees to allocate a vehicle to
        // one — scoped strictly to employee-role records, not every user.
        || (mobilityUserRole() == 'mobility_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.role == 'employee');
      allow write: if false;
    }

    // ==========================================================
    // observations/{obsId} — tenant isolation, NO owner access
    // ==========================================================
    match /observations/{obsId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (isActiveOrgUser() && resource.data.organizationId == orgUserOrgId());

      allow create: if orgUserRole() == 'inspector'
        && request.resource.data.organizationId == orgUserOrgId()
        && request.resource.data.createdByUid == request.auth.uid;

      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && (canManagerUpdateObservation() || canSupervisorUpdateObservation()
            || canInspectorUpdateObservation() || canContractorUpdateObservation());

      // manager-only, same-org (manager.html:1775 deleteObservation)
      allow delete: if isActiveManager() && resource.data.organizationId == managerOrgId();
    }

    // manager: cycleStatus / closeTicket / confirmAssign (manager.html:981,991,1037)
    function canManagerUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isActiveManager()
        && resource.data.organizationId == managerOrgId()
        && changedKeys.hasOnly(
             ['status', 'closedAt', 'updatedByUid', 'updatedAt',
              'assignedContractorUid', 'assignedByUid', 'assignedAt', 'supervisorNote'])
        && (!changedKeys.hasAny(['updatedByUid']) || request.resource.data.updatedByUid == request.auth.uid);
    }

    // supervisor: confirmAssign / review-return (manager.html:1037) — a
    // separate least-privilege branch, never merged into the manager branch.
    // Assignment fields + supervisorNote are allowed; COMPLETED and delete
    // remain manager-exclusive.
    function canSupervisorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'supervisor'
        && resource.data.organizationId == orgUserOrgId()
        && request.resource.data.createdByUid == resource.data.createdByUid
        && changedKeys.hasOnly(
             ['status', 'supervisorNote', 'assignedContractorUid',
              'assignedByUid', 'assignedAt', 'updatedByUid', 'updatedAt'])
        && request.resource.data.updatedByUid == request.auth.uid
        && (
          !changedKeys.hasAny(['status'])
          || (resource.data.status == 'PENDING' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'PENDING_REVIEW' && request.resource.data.status == 'IN_PROGRESS')
        );
    }

    // inspector: completeObservation (dashboard.html:4373)
    function canInspectorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'inspector'
        && resource.data.organizationId == orgUserOrgId()
        && changedKeys.hasOnly(['status', 'isComparative', 'afterImagePath', 'resolutionNote']);
    }

    // contractor: status/resolution flow (mobile-map.html:1460, :1470/:1171)
    function canContractorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'contractor'
        && resource.data.organizationId == orgUserOrgId()
        && changedKeys.hasOnly(['status', 'resolutionNote', 'afterImagePath', 'updatedByUid', 'updatedAt'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // ==========================================================
    // missions/{missionId} — Smart Mobility shared mission lifecycle.
    // Tenant isolation, department scoping for department_head, and
    // assignment scoping for employee. Mirrors
    // platform/policies/mission-workflow-policy.js — keep both in sync.
    // ==========================================================
    match /missions/{missionId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() == 'mobility_head' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'administrative_affairs' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'department_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.department == mobilityUserDept())
        || (mobilityUserRole() == 'employee' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.assignedEmployeeUid == request.auth.uid);

      // Only a department head may create a mission request, as a DRAFT, in
      // their own organization and department, self-attributed.
      allow create: if mobilityUserRole() == 'department_head'
        && request.resource.data.organizationId == mobilityUserOrgId()
        && request.resource.data.department == mobilityUserDept()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'DRAFT';

      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && (canDeptHeadSubmitMission() || canAdminAffairsDecideMission()
            || canMobilityHeadAdvanceMission() || canEmployeeAdvanceMission());

      // Missions are append/close only — never deleted.
      allow delete: if false;
    }

    // department_head: DRAFT -> PENDING_APPROVAL, own mission only.
    function canDeptHeadSubmitMission() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'department_head'
        && resource.data.organizationId == mobilityUserOrgId()
        && resource.data.department == mobilityUserDept()
        && resource.data.createdByUid == request.auth.uid
        && resource.data.status == 'DRAFT' && request.resource.data.status == 'PENDING_APPROVAL'
        && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // administrative_affairs: PENDING_APPROVAL -> APPROVED | REJECTED | DRAFT.
    function canAdminAffairsDecideMission() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'administrative_affairs'
        && resource.data.organizationId == mobilityUserOrgId()
        && resource.data.status == 'PENDING_APPROVAL'
        && (request.resource.data.status == 'APPROVED'
            || request.resource.data.status == 'REJECTED'
            || request.resource.data.status == 'DRAFT')
        && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // mobility_head: allocate vehicle, handover, resume after incident,
    // confirm return.
    function canMobilityHeadAdvanceMission() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'mobility_head'
        && resource.data.organizationId == mobilityUserOrgId()
        && (
          (resource.data.status == 'APPROVED' && request.resource.data.status == 'VEHICLE_ALLOCATED'
            && changedKeys.hasOnly(['status', 'vehicleId', 'assignedEmployeeUid', 'updatedAt', 'updatedByUid'])
            && request.resource.data.vehicleId is string && request.resource.data.vehicleId.size() > 0
            && request.resource.data.assignedEmployeeUid is string && request.resource.data.assignedEmployeeUid.size() > 0
            // Conflict-prevention cross-check: refuse to allocate a vehicle
            // that is not currently AVAILABLE. Real atomicity against a
            // second, racing allocation still requires the caller to write
            // this and the vehicle doc inside one runTransaction() — see
            // platform/policies/vehicle-workflow-policy.js.
            && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.organizationId == mobilityUserOrgId()
            && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.status == 'AVAILABLE')
          || (resource.data.status == 'VEHICLE_ALLOCATED' && request.resource.data.status == 'HANDED_OVER'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
          || (resource.data.status == 'INCIDENT_HOLD' && request.resource.data.status == 'IN_PROGRESS'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
          || (resource.data.status == 'AWAITING_RETURN' && request.resource.data.status == 'CLOSED'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
        )
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // employee: receive, start, report/resolve incident, finish, return
    // vehicle — only on a mission assigned to them.
    function canEmployeeAdvanceMission() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'employee'
        && resource.data.organizationId == mobilityUserOrgId()
        && resource.data.assignedEmployeeUid == request.auth.uid
        && (
          (resource.data.status == 'HANDED_OVER' && request.resource.data.status == 'READY')
          || (resource.data.status == 'READY' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'IN_PROGRESS' && (request.resource.data.status == 'INCIDENT_HOLD'
              || request.resource.data.status == 'COMPLETED'))
          || (resource.data.status == 'INCIDENT_HOLD' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'COMPLETED' && request.resource.data.status == 'AWAITING_RETURN')
        )
        && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // ==========================================================
    // vehicles/{vehicleId} — Smart Mobility fleet lifecycle. Tenant
    // isolation; only mobility_head manages the roster and its state;
    // the assigned employee may only report a return. Mirrors
    // platform/policies/vehicle-workflow-policy.js — keep both in sync.
    // ==========================================================
    match /vehicles/{vehicleId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() == 'mobility_head' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'administrative_affairs' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'employee' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.assignedEmployeeUid == request.auth.uid);

      // Only mobility_head adds vehicles to the roster, always starting
      // AVAILABLE with no stale mission commitment.
      allow create: if mobilityUserRole() == 'mobility_head'
        && request.resource.data.organizationId == mobilityUserOrgId()
        && request.resource.data.status == 'AVAILABLE'
        && !('assignedEmployeeUid' in request.resource.data)
        && !('currentMissionId' in request.resource.data);

      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && (canMobilityHeadManageVehicle() || canEmployeeReturnVehicle());

      // Vehicles are never deleted — retired vehicles move to
      // OUT_OF_SERVICE so their history stays auditable.
      allow delete: if false;
    }

    // mobility_head: allocate (with conflict-prevention cross-check
    // against the target mission), maintenance toggles, handover,
    // confirm return.
    function canMobilityHeadManageVehicle() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'mobility_head'
        && resource.data.organizationId == mobilityUserOrgId()
        && (
          (resource.data.status == 'AVAILABLE' && request.resource.data.status == 'RESERVED'
            && changedKeys.hasOnly(['status', 'assignedEmployeeUid', 'currentMissionId', 'updatedAt', 'updatedByUid'])
            && request.resource.data.assignedEmployeeUid is string && request.resource.data.assignedEmployeeUid.size() > 0
            && request.resource.data.currentMissionId is string && request.resource.data.currentMissionId.size() > 0
            // Conflict-prevention cross-check: the mission being allocated
            // must actually be APPROVED and in this same organization.
            && get(/databases/$(database)/documents/missions/$(request.resource.data.currentMissionId)).data.organizationId == mobilityUserOrgId()
            && get(/databases/$(database)/documents/missions/$(request.resource.data.currentMissionId)).data.status == 'APPROVED')
          || (resource.data.status == 'AVAILABLE'
            && (request.resource.data.status == 'MAINTENANCE' || request.resource.data.status == 'OUT_OF_SERVICE')
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
          || (resource.data.status == 'RESERVED' && request.resource.data.status == 'IN_MISSION'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
          || (resource.data.status == 'RETURN_PENDING' && request.resource.data.status == 'AVAILABLE'
            && changedKeys.hasOnly(['status', 'assignedEmployeeUid', 'currentMissionId', 'updatedAt', 'updatedByUid'])
            && !('assignedEmployeeUid' in request.resource.data) && !('currentMissionId' in request.resource.data))
          || ((resource.data.status == 'MAINTENANCE' || resource.data.status == 'OUT_OF_SERVICE')
            && request.resource.data.status == 'AVAILABLE'
            && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid']))
        )
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // employee: report a return, only on the vehicle assigned to them.
    function canEmployeeReturnVehicle() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return mobilityUserRole() == 'employee'
        && resource.data.organizationId == mobilityUserOrgId()
        && resource.data.assignedEmployeeUid == request.auth.uid
        && resource.data.status == 'IN_MISSION' && request.resource.data.status == 'RETURN_PENDING'
        && changedKeys.hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    // ==========================================================
    // presence/{presenceId} — verified deployed behavior, manager-only
    // ==========================================================
    match /presence/{presenceId} {
      allow read: if isActiveManager();
      allow write: if isActiveManager()
        && presenceId == request.auth.token.email;
    }

    // ==========================================================
    // organizations/{orgId} — active owner only
    // ==========================================================
    match /organizations/{orgId} {
      allow read, write: if isActiveOwner();
    }

    // ==========================================================
    // invoices/{invoiceId} — active owner only (read + create; no
    // update/delete call site exists in the app)
    // ==========================================================
    match /invoices/{invoiceId} {
      allow read: if isActiveOwner();
      allow create: if isActiveOwner();
      allow update, delete: if false;
    }

    // ==========================================================
    // incidents/{incidentId} — Smart Mobility incident lifecycle. Created
    // only by the employee assigned to the referenced mission while it is
    // IN_PROGRESS; processed only by mobility_head. Mirrors
    // platform/policies/incident-workflow-policy.js — keep both in sync.
    // ==========================================================
    match /incidents/{incidentId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() == 'mobility_head' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'administrative_affairs' && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'department_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.department == mobilityUserDept())
        || (mobilityUserRole() == 'employee' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.createdByUid == request.auth.uid);

      // Only the employee assigned to the referenced (currently
      // IN_PROGRESS) mission may open an incident against it.
      allow create: if mobilityUserRole() == 'employee'
        && request.resource.data.organizationId == mobilityUserOrgId()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'NEW'
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.organizationId == mobilityUserOrgId()
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.assignedEmployeeUid == request.auth.uid
        && get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.status == 'IN_PROGRESS';

      // mobility_head processes: NEW -> ACKNOWLEDGED -> IN_PROGRESS -> RESOLVED.
      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && mobilityUserRole() == 'mobility_head'
        && resource.data.organizationId == mobilityUserOrgId()
        && (
          (resource.data.status == 'NEW' && request.resource.data.status == 'ACKNOWLEDGED')
          || (resource.data.status == 'ACKNOWLEDGED' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'IN_PROGRESS' && request.resource.data.status == 'RESOLVED')
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedByUid'])
        && request.resource.data.updatedByUid == request.auth.uid;

      // Incidents are never deleted — they are the record of what happened.
      allow delete: if false;
    }

    // ==========================================================
    // auditEvents/{eventId} — append-only Smart Mobility audit trail.
    // Every mission/vehicle/incident transition writes one of these.
    // Mirrors platform/audit/mobility-audit-event-contract.js.
    // ==========================================================
    match /auditEvents/{eventId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (mobilityUserRole() in ['mobility_head', 'administrative_affairs'] && resource.data.organizationId == mobilityUserOrgId())
        || (mobilityUserRole() == 'department_head' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.department == mobilityUserDept())
        || (mobilityUserRole() == 'employee' && resource.data.organizationId == mobilityUserOrgId()
            && resource.data.actorId == request.auth.uid);

      // An actor may only ever record an event as themselves, in their own
      // organization — never on another user's behalf, never cross-tenant.
      allow create: if isActiveMobilityUser()
        && request.resource.data.organizationId == mobilityUserOrgId()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == mobilityUserRole()
        && request.resource.data.resourceType in ['mission', 'vehicle', 'incident'];

      // Audit records are immutable once written.
      allow update, delete: if false;
    }

    // ==========================================================
    // Final fallback — everything else denied.
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
