rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // Helpers
    // ==========================================================
    function signedIn() {
      return request.auth != null;
    }

    // --- Owner ---
    // active-owner check is used ONLY by organizations/ and invoices/
    // below. It grants no access to users/ or observations/ — that
    // owner bypass was removed intentionally (verified deployed
    // behavior: owner has no access to those two collections).
    function ownerRecord() {
      return get(/databases/$(database)/documents/owners/$(request.auth.uid));
    }
    function isActiveOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && ownerRecord().data.active != false;
    }

    // --- Manager ---
    function managerRecord() {
      return get(/databases/$(database)/documents/managers/$(request.auth.uid));
    }
    function isActiveManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/managers/$(request.auth.uid))
        && managerRecord().data.role == 'manager'
        && managerRecord().data.active != false
        && managerRecord().data.organizationId is string
        && managerRecord().data.organizationId.size() > 0;
    }
    function managerOrgId() {
      return isActiveManager() ? managerRecord().data.organizationId : null;
    }

    // --- Supervisor / inspector / contractor (users/{uid}) ---
    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActiveOrgUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRecord().data.role in ['supervisor', 'inspector', 'contractor']
        && userRecord().data.active != false
        && userRecord().data.organizationId is string
        && userRecord().data.organizationId.size() > 0;
    }
    function orgUserOrgId() {
      return isActiveOrgUser() ? userRecord().data.organizationId : null;
    }
    function orgUserRole() {
      return isActiveOrgUser() ? userRecord().data.role : null;
    }

    // ==========================================================
    // managers/{managerId} — signed-in self-read only, no client writes
    // ==========================================================
    match /managers/{managerId} {
      allow read: if request.auth.uid == managerId;
      allow write: if false;
    }

    // ==========================================================
    // owners/{ownerId} — signed-in self-read only, no client writes
    // ==========================================================
    match /owners/{ownerId} {
      allow read: if request.auth.uid == ownerId;
      allow write: if false;
    }

    // ==========================================================
    // users/{userId} — tenant isolation, NO owner access
    // ==========================================================
    match /users/{userId} {
      allow read: if request.auth.uid == userId
        || (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (orgUserRole() == 'supervisor' && resource.data.organizationId == orgUserOrgId());
      allow write: if false;
    }

    // ==========================================================
    // observations/{obsId} — tenant isolation, NO owner access
    // ==========================================================
    match /observations/{obsId} {
      allow read: if (isActiveManager() && resource.data.organizationId == managerOrgId())
        || (isActiveOrgUser() && resource.data.organizationId == orgUserOrgId());

      allow create: if orgUserRole() == 'inspector'
        && validInspectorObservationCreate(obsId);

      allow update: if request.resource.data.organizationId == resource.data.organizationId
        && (canManagerUpdateObservation() || canSupervisorUpdateObservation()
            || canInspectorUpdateObservation() || canContractorUpdateObservation());

      // manager-only, same-org (manager.html:1775 deleteObservation)
      allow delete: if isActiveManager() && resource.data.organizationId == managerOrgId();
    }

    function validInspectorObservationCreate(obsId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'clientRequestId', 'organizationId', 'createdByUid', 'status',
          'displayId', 'type', 'date', 'title', 'details', 'imagePath',
          'imageObjectKey', 'isComparative', 'actionPlan', 'riskAssessment',
          'location', 'originalLat', 'originalLng', 'correctedLat',
          'correctedLng', 'locationAccuracyMeters', 'locationCapturedAt',
          'locationSource', 'locationVerified', 'createdAt'
        ])
        && data.clientRequestId == obsId
        && data.clientRequestId is string
        && data.organizationId == orgUserOrgId()
        && data.createdByUid == request.auth.uid
        && data.status == 'PENDING'
        && data.displayId is int
        && data.type is string
        && data.date is string
        && data.title is string
        && data.details is string
        && data.imagePath is string
        && (!data.keys().hasAny(['imageObjectKey'])
            || data.imageObjectKey == null
            || data.imageObjectKey is string)
        && data.isComparative == false
        && data.actionPlan is string
        && data.riskAssessment is map
        && data.riskAssessment.keys().hasOnly(['priority', 'timeframe'])
        && data.location is string
        && data.locationSource is string
        && data.locationVerified is bool
        && data.createdAt == request.time;
    }

    // manager: cycleStatus / closeTicket / confirmAssign (manager.html:981,991,1037)
    function canManagerUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isActiveManager()
        && resource.data.organizationId == managerOrgId()
        && resource.data.status != 'COMPLETED'
        && changedKeys.hasOnly(
             ['status', 'closedAt', 'updatedByUid', 'updatedAt',
              'assignedContractorUid', 'assignedByUid', 'assignedAt', 'supervisorNote'])
        && (!changedKeys.hasAny(['updatedByUid']) || request.resource.data.updatedByUid == request.auth.uid)
        && (!changedKeys.hasAny(['status']) || isManagerTransition());
    }

    function isManagerTransition() {
      return (resource.data.status == 'PENDING' && request.resource.data.status == 'IN_PROGRESS')
        || (resource.data.status == 'PENDING_REVIEW' && request.resource.data.status == 'IN_PROGRESS')
        || (resource.data.status == 'PENDING_REVIEW' && request.resource.data.status == 'COMPLETED');
    }

    // supervisor: confirmAssign / review-return (manager.html:1037) — a
    // separate least-privilege branch, never merged into the manager branch.
    // Assignment fields + supervisorNote are allowed; COMPLETED and delete
    // remain manager-exclusive.
    function canSupervisorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'supervisor'
        && resource.data.organizationId == orgUserOrgId()
        && resource.data.status != 'COMPLETED'
        && request.resource.data.createdByUid == resource.data.createdByUid
        && changedKeys.hasOnly(
             ['status', 'supervisorNote', 'assignedContractorUid',
              'assignedByUid', 'assignedAt', 'updatedByUid', 'updatedAt'])
        && request.resource.data.updatedByUid == request.auth.uid
        && (
          !changedKeys.hasAny(['status'])
          || (resource.data.status == 'PENDING' && request.resource.data.status == 'IN_PROGRESS')
          || (resource.data.status == 'PENDING_REVIEW' && request.resource.data.status == 'IN_PROGRESS')
        );
    }

    // inspector: completeObservation (dashboard.html:4373)
    function canInspectorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'inspector'
        && resource.data.organizationId == orgUserOrgId()
        && resource.data.status != 'COMPLETED'
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && !resource.data.keys().hasAny(['assignedContractorUid'])
        && request.resource.data.status == resource.data.status
        && changedKeys.hasOnly(['isComparative', 'afterImagePath', 'resolutionNote']);
    }

    // contractor: status/resolution flow (mobile-map.html:1460, :1470/:1171)
    function canContractorUpdateObservation() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return orgUserRole() == 'contractor'
        && resource.data.organizationId == orgUserOrgId()
        && resource.data.status != 'COMPLETED'
        && resource.data.assignedContractorUid == request.auth.uid
        && request.resource.data.assignedContractorUid == resource.data.assignedContractorUid
        && changedKeys.hasOnly(['status', 'resolutionNote', 'afterImagePath', 'updatedByUid', 'updatedAt'])
        && request.resource.data.updatedByUid == request.auth.uid
        && (!changedKeys.hasAny(['status']) || isContractorTransition());
    }

    function isContractorTransition() {
      return (resource.data.status == 'PENDING' && request.resource.data.status == 'IN_PROGRESS')
        || (resource.data.status == 'IN_PROGRESS' && request.resource.data.status == 'PENDING_REVIEW');
    }

    // ==========================================================
    // presence/{presenceId} — manager-only, same-organization only.
    // Phase 25 audit fix: read was previously unscoped by organizationId
    // (any active manager, any organization) and write did not verify the
    // written organizationId matched the manager's own — both closed here,
    // mirroring the existing users/ and observations/ tenant-isolation
    // pattern. Confirmed via test/phase25-multi-org-isolation.test.js.
    // ==========================================================
    match /presence/{presenceId} {
      allow read: if isActiveManager()
        && resource.data.organizationId == managerOrgId();
      allow write: if isActiveManager()
        && presenceId == request.auth.token.email
        && request.resource.data.organizationId == managerOrgId();
    }

    // ==========================================================
    // organizations/{orgId} — active owner only
    // ==========================================================
    match /organizations/{orgId} {
      allow read, write: if isActiveOwner();
    }

    // ==========================================================
    // invoices/{invoiceId} — active owner only (read + create; no
    // update/delete call site exists in the app)
    // ==========================================================
    match /invoices/{invoiceId} {
      allow read: if isActiveOwner();
      allow create: if isActiveOwner();
      allow update, delete: if false;
    }


    // ==========================================================
    // SMART HSR Lands — candidate tenant boundary
    // Candidate source-of-truth only. Client SDK gets:
    //   - membership/self reads
    //   - tenant-scoped reads
    //   - create-only draft/domain/document metadata writes
    // All consequential updates/deletes remain server/Admin-only and are
    // therefore denied to every browser client here.
    // ==========================================================
    function landsAccessPath(municipalityId, uid) {
      return /databases/$(database)/documents/landsMunicipalities/$(municipalityId)/userAccess/$(uid);
    }

    function landsAccessRecord(municipalityId) {
      return get(landsAccessPath(municipalityId, request.auth.uid));
    }

    function isActiveLandsUser(municipalityId) {
      return signedIn()
        && exists(landsAccessPath(municipalityId, request.auth.uid))
        && landsAccessRecord(municipalityId).data.firebase_uid == request.auth.uid
        && landsAccessRecord(municipalityId).data.municipality_id == municipalityId
        && landsAccessRecord(municipalityId).data.enabled == true
        && landsAccessRecord(municipalityId).data.lands_role in [
          'municipal_manager', 'lands_department_manager', 'lands_employee'
        ];
    }

    function landsRole(municipalityId) {
      return isActiveLandsUser(municipalityId)
        ? landsAccessRecord(municipalityId).data.lands_role
        : null;
    }

    function isLandsReviewer(municipalityId) {
      return landsRole(municipalityId) in ['municipal_manager', 'lands_department_manager'];
    }

    function isLandsManager(municipalityId) {
      return landsRole(municipalityId) == 'municipal_manager';
    }

    function isLandsDomain(domain) {
      return domain in [
        'royalOrders', 'allocationDecisions', 'beneficiaries', 'plans', 'parcels'
      ];
    }

    function isLandsDocumentDomain(domain) {
      return domain in [
        'landGrants', 'royalOrders', 'allocationDecisions',
        'beneficiaries', 'plans', 'parcels'
      ];
    }

    function validLandsDomainCreate(municipalityId) {
      let data = request.resource.data;
      return isActiveLandsUser(municipalityId)
        && data.keys().hasOnly([
          'municipality_id', 'created_by', 'created_at', 'updated_at',
          'reference_id', 'name', 'description', 'land_grant_id',
          'royal_order_id', 'allocation_decision_id', 'beneficiary_id',
          'plan_id', 'parcel_id', 'document_ids'
        ])
        && data.municipality_id == municipalityId
        && data.created_by == request.auth.uid
        && data.updated_at == request.time
        && (!data.keys().hasAny(['created_at']) || data.created_at == request.time);
    }

    function validLandsGrantCreate(municipalityId) {
      let data = request.resource.data;
      return isActiveLandsUser(municipalityId)
        && data.keys().hasOnly([
          'municipality_id', 'beneficiary', 'royal_order',
          'allocation_decision', 'status', 'created_by',
          'created_at', 'updated_at'
        ])
        && data.municipality_id == municipalityId
        && data.created_by == request.auth.uid
        && data.status == 'draft'
        && data.created_at == request.time
        && data.updated_at == request.time
        && data.beneficiary is map
        && data.beneficiary.keys().hasOnly(['name', 'national_id'])
        && data.beneficiary.name is string
        && data.beneficiary.name.size() > 0
        && data.beneficiary.name.size() <= 240
        && (data.beneficiary.national_id == null || data.beneficiary.national_id is string)
        && data.royal_order is map
        && data.royal_order.keys().hasOnly(['number', 'date'])
        && (data.royal_order.number == null || data.royal_order.number is string)
        && (data.royal_order.date == null || data.royal_order.date is string)
        && data.allocation_decision == null;
    }

    function validLandsDocumentCreate(municipalityId, documentId) {
      let data = request.resource.data;
      return isActiveLandsUser(municipalityId)
        && data.keys().hasOnly([
          'municipality_id', 'created_by', 'record_domain', 'record_id',
          'file_id', 'filename', 'mime_type', 'size_bytes', 'storage_path',
          'created_at', 'updated_at'
        ])
        && data.municipality_id == municipalityId
        && data.created_by == request.auth.uid
        && isLandsDocumentDomain(data.record_domain)
        && data.record_id is string
        && data.record_id.size() > 0
        && data.record_id.size() <= 128
        && data.file_id == documentId
        && data.filename is string
        && data.filename.size() > 0
        && data.filename.size() <= 128
        && data.mime_type in ['application/pdf', 'image/jpeg', 'image/png']
        && data.size_bytes is int
        && data.size_bytes > 0
        && data.size_bytes <= 10 * 1024 * 1024
        && data.storage_path == 'landsMunicipalities/' + municipalityId
          + '/documents/' + data.record_domain + '/' + data.record_id + '/' + documentId
        && data.created_at == request.time
        && data.updated_at == request.time;
    }

    match /landsMunicipalities/{municipalityId} {
      allow read, write: if false;

      match /userAccess/{userId} {
        allow get: if signedIn()
          && resource.data.firebase_uid == userId
          && resource.data.municipality_id == municipalityId
          && (
            request.auth.uid == userId
            || isLandsManager(municipalityId)
          );
        allow list: if isLandsManager(municipalityId)
          && resource.data.municipality_id == municipalityId;
        allow create, update, delete: if false;
      }

      match /landGrants/{grantId} {
        allow read: if isActiveLandsUser(municipalityId)
          && resource.data.municipality_id == municipalityId;
        allow create: if validLandsGrantCreate(municipalityId);
        allow update, delete: if false;
      }

      match /documents/{documentId} {
        allow read: if isActiveLandsUser(municipalityId)
          && resource.data.municipality_id == municipalityId;
        allow create: if validLandsDocumentCreate(municipalityId, documentId);
        allow update, delete: if false;
      }

      match /auditLogs/{eventId} {
        allow read: if isLandsReviewer(municipalityId)
          && resource.data.municipality_id == municipalityId;
        allow create, update, delete: if false;
      }

      match /{domain}/{recordId} {
        allow read: if isLandsDomain(domain)
          && isActiveLandsUser(municipalityId)
          && resource.data.municipality_id == municipalityId;
        allow create: if isLandsDomain(domain)
          && validLandsDomainCreate(municipalityId);
        allow update, delete: if false;
      }

      match /{landsPath=**} {
        allow read, write: if false;
      }
    }

    // ==========================================================
    // Final fallback — everything else denied.
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
