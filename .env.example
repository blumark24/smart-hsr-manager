SMART_HSR_REAL_AI_EVALUATION=false
SMART_HSR_SYNTHETIC_DATA_ONLY=false
SMART_HSR_NO_APP_INTEGRATION=true
SMART_HSR_AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_MODEL_SUPPORTS_VISION=false
OPENROUTER_MODEL_SUPPORTS_STRUCTURED_OUTPUT=false

# Sprint 6.8: separate, explicit opt-in for REAL Gemini calls from the live
# Inspector app (api/ai/analyze.js), distinct from the synthetic-only
# evaluation flags above. Leave false until the Al-Qunfudhah pilot is ready
# to go live; SMART_HSR_AI_PROVIDER and GEMINI_API_KEY/GEMINI_VISION_MODEL
# above are still required in addition to this flag.
SMART_HSR_AI_APPLICATION_INTEGRATION=false

# Manager -> Smart HSR Lands trusted-mutation bridge (api/_lib/landsBridge.js,
# api/admin/lands-bootstrap.js). Base URL of the Lands app's deployment, e.g.
# https://lands-smart-git-staging-lands-trusted-audit-blumark24-os.vercel.app
# Only ever meaningful where this app and Lands share the same Firebase
# project (currently Preview only). Leave unset to disable the bridge
# entirely — every call then safely no-ops with reason
# "lands_bridge_not_configured" instead of failing.
LANDS_TRUSTED_API_URL=

# Optional: the Lands Preview deployment sits behind Vercel Deployment
# Protection like this app's own Preview does. This is the Lands project's
# own pre-existing "Protection Bypass for Automation" secret (Vercel
# project settings -> Deployment Protection), forwarded as
# x-vercel-protection-bypass so the bridge request reaches Lands' real
# handler. It only gets past Vercel's platform gate — Lands' own
# authorization (verifyIdToken, entitlement checks, anti-self-escalation
# rule) still applies in full. Leave unset if Lands' Preview has no
# protection enabled.
LANDS_TRUSTED_API_BYPASS_SECRET=
